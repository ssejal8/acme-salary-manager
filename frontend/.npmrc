# npm 10.9.x crashes with "Cannot read properties of null (reading 'edgesOut')" while
# resolving Vitest's peer graph, which Angular 21 pulls in as its default test runner.
# The bug is in npm's dependency resolver, not in this project's dependency set.
#
# Remove this file once the toolchain moves to npm 11 (Node 22.22.3+ or 24.15+, which is
# also Angular 22's floor). Until then `npm install` fails without it, and a flag nobody
# remembers to type is worse than a documented setting.
legacy-peer-deps=true
