# Copy to .env and fill in. Never commit .env (NFR-2.5).
# The dev profile has working defaults for everything except nothing — it will start
# against the docker-compose database with no .env at all. These values are here for
# when you need to point at something else, and as the contract for deployed environments.

# Active Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# HTTP
SERVER_PORT=8080

# Database (required in prod; dev defaults to the docker-compose instance)
DB_URL=jdbc:postgresql://localhost:5432/salary_mgmt
DB_USERNAME=salary_app
DB_PASSWORD=salary_app_dev

# JWT signing (required in prod; must be at least 32 bytes of random data)
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# Payslip email — optional. Unset means payslip delivery degrades to in-app download
# only (requirements §2.4, FR-6.7).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
